# Mobile RL orchestrator defaults (editable).
# Environment variables here can be overridden at runtime.

# Benchmarks
ROLLOUT_BACKEND="${ROLLOUT_BACKEND:-adb}"
BENCHMARK_POLICY="${BENCHMARK_POLICY:-scripted}"
BENCHMARK_SAMPLES_PER_TASK="${BENCHMARK_SAMPLES_PER_TASK:-10}"
BENCHMARK_ATTEMPTS="${BENCHMARK_ATTEMPTS:-20}"
BENCHMARK_ATTEMPTS_QUICK="${BENCHMARK_ATTEMPTS_QUICK:-4}"
BENCHMARK_ATTEMPTS_RELEASE="${BENCHMARK_ATTEMPTS_RELEASE:-20}"
BENCHMARK_MAX_STEPS="${BENCHMARK_MAX_STEPS:-12}"
BENCHMARK_BOOTSTRAP_SAMPLES="${BENCHMARK_BOOTSTRAP_SAMPLES:-0}"
BENCHMARK_PASS_K="${BENCHMARK_PASS_K:-1 2 3 5 10}"
MOBILE_BENCHMARK_OUTPUT_PREFIX="${MOBILE_BENCHMARK_OUTPUT_PREFIX:-artifacts/benchmarks}"

# Device/bootstrap behavior
PROOF_DEVICE_TIMEOUT_S="${PROOF_DEVICE_TIMEOUT_S:-180}"
COLLECT_SCREENSHOT="${COLLECT_SCREENSHOT:-0}"
POOL_SIZE="${POOL_SIZE:-1}"
RESET_MODE="${RESET_MODE:-snapshot}"
ADB_BASE_CONSOLE_PORT="${ADB_BASE_CONSOLE_PORT:-5554}"
ADB_BASE_GRPC_PORT="${ADB_BASE_GRPC_PORT:-8554}"
ADB_BASELINE_SNAPSHOT="${ADB_BASELINE_SNAPSHOT:-com_primeintellect_dummyrl_baseline}"
MOBILE_REQUIRE_KVM="${MOBILE_REQUIRE_KVM:-1}"
ANDROID_WORLD_REF="${ANDROID_WORLD_REF:-d9c569f764b3a5629321858de03ff653d0f24056}"

# Rollout
ROLLOUT_WITH_OPENAI="${ROLLOUT_WITH_OPENAI:-0}"
ROLLOUT_ARTIFACT_ROOT="${ROLLOUT_ARTIFACT_ROOT:-artifacts/runs}"

# Pipeline behavior (mobile_rl.sh pipeline)
MOBILE_PIPELINE_PRESET="${MOBILE_PIPELINE_PRESET:-proof}"
MOBILE_PIPELINE_BENCHMARK="${MOBILE_PIPELINE_BENCHMARK:-1}"
MOBILE_PIPELINE_ROLLOUT="${MOBILE_PIPELINE_ROLLOUT:-1}"
MOBILE_PIPELINE_PRIME="${MOBILE_PIPELINE_PRIME:-0}"
MOBILE_PIPELINE_ANDROID_WORLD="${MOBILE_PIPELINE_ANDROID_WORLD:-0}"

# AndroidWorld
ANDROID_WORLD_EPISODES="${ANDROID_WORLD_EPISODES:-1}"
ANDROID_WORLD_MAX_STEPS="${ANDROID_WORLD_MAX_STEPS:-15}"
ANDROID_WORLD_MODEL="${ANDROID_WORLD_MODEL:-gpt-4o-mini}"
ANDROID_WORLD_START_EMULATOR="${ANDROID_WORLD_START_EMULATOR:-1}"
ANDROID_WORLD_STOP_EMULATOR_AFTER_RUN="${ANDROID_WORLD_STOP_EMULATOR_AFTER_RUN:-0}"

# Prime eval
PRIME_ANDROID_BACKEND="${PRIME_ANDROID_BACKEND:-adb}"
PRIME_PROVIDER="${PRIME_PROVIDER:-openai}"
PRIME_MODEL="${PRIME_MODEL:-gpt-4o-mini}"
PRIME_MAX_TURNS="${PRIME_MAX_TURNS:-15}"
PRIME_START_EMULATOR="${PRIME_START_EMULATOR:-0}"
PRIME_STOP_EMULATOR_AFTER_RUN="${PRIME_STOP_EMULATOR_AFTER_RUN:-0}"
