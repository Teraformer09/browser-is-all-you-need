<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="76dp" android:layout_height="88dp" android:orientation="vertical"
    android:gravity="center_horizontal" android:paddingTop="8dp" android:clickable="true" android:focusable="true">
    <FrameLayout android:id="@+id/categoryBubble" android:layout_width="54dp" android:layout_height="54dp"
        android:background="@drawable/bg_circle_category">
        <ImageView android:id="@+id/ivCategoryIcon" android:layout_width="29dp" android:layout_height="29dp"
            android:layout_gravity="center" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/tvCategoryName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:textSize="11sp" android:fontFamily="sans-serif-medium"
        android:textColor="#0F1111" android:includeFontPadding="false" />
</LinearLayout>
