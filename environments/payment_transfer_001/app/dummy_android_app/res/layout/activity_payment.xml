<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:id="@+id/payment_scroll" android:fillViewport="true" android:background="#F4F8F6">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Payment Demo" android:textSize="28sp" android:textStyle="bold" android:textColor="#102B29"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="SIMULATED • NO MONEY MOVES" android:textColor="#006B5E"/>
        <TextView android:id="@+id/progress_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Prepare your transfer"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/stage_progress" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:max="6" android:progress="0"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:id="@+id/recipient_label" android:text="1 · Choose a recipient" android:textColor="#102B29" android:textStyle="bold" android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/recipient_group"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/recipient_alex" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Alex"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/recipient_blair" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Blair"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="2 · Enter the amount" android:textColor="#102B29" android:textStyle="bold" android:textSize="16sp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Amount in INR" app:prefixText="₹ ">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:maxLength="20" android:singleLine="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:id="@+id/account_label" android:text="3 · Select a mock account" android:textColor="#102B29" android:textStyle="bold" android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/account_group"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/account_1234" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mock • 1234"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/account_5678" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mock • 5678"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="4 · Add a note" android:textColor="#102B29" android:textStyle="bold" android:textSize="16sp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Payment note">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/note_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences" android:maxLength="80" android:singleLine="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/review_button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Review transfer"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/review_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:visibility="gone" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Review your transfer" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:id="@+id/review_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="16sp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/confirm_transfer_button"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="Confirm simulated payment"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/status_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#102B29"
            android:accessibilityLiveRegion="polite"/>
        <TextView android:id="@+id/receipt_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textIsSelectable="true"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
